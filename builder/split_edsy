#!/bin/sh

#
# Split deploy/edsy.js into src/edsy.part_1.js and src/edsy.part_2.js
#

#
# Author: Martin Eden
# Last mod.: 2026-11-25
#

# Actually this implementation was generated by Devin from my design.
# I'm not fan of that "head/cut/[]" pesky tricks but I think it works.
# And it's not too important for me to step in and change implementation.

# Cut point:
#
#  /*
#  * MODULES & ATTRIBUTES
#  */

set -e -u

cd "$(dirname "$0")"

src=../deploy/edsy.js

# Find the banner line, then back up to its opening "/*"
anchor=$(grep -n -F 'MODULES & ATTRIBUTES' $src | head -1 | cut -d: -f1)
[ -n "$anchor" ] || { echo "Anchor not found in $src"; exit 1; }
cut_line=$((anchor - 1))

head -n $((cut_line - 1)) $src > ../src/edsy.part_1.js
tail -n +$cut_line $src > ../src/edsy.part_2.js

